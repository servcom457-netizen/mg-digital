# GEMINI_API_KEY: Required for Gemini AI API calls if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_SESSION_SECRET: Server-side secret for signing sessions and temporary download tokens.
APP_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Payment Gateway Credentials (Server-side only — never expose in frontend)
MONCASH_MODE="sandbox"
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
MONCASH_WEBHOOK_SECRET=""

NATCASH_MODE="sandbox"
NATCASH_MERCHANT_ID=""
NATCASH_API_KEY=""
NATCASH_WEBHOOK_SECRET=""

PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

USDT_BEP20_MODE="sandbox"
USDT_BEP20_MERCHANT_ADDRESS=""
